# Deterministic, provider-free CLI demo.
Output media/output/quickstart.gif
Set Shell bash
Set FontFamily "JetBrains Mono"
Set Theme "Dracula"
Set Width 1200
Set Height 720
Type "uv run openfatture --version"
Enter
Sleep 2s
Type "uv run openfatture status --json"
Enter
Sleep 2s
Type "uv run openfatture assistant --help"
Enter
Sleep 2s
Type "uv run openfatture interactive --help"
Enter
Sleep 2s
